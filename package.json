{
  "name": "@daydrift/mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "keygen": "node tools/keygen.mjs",
    "sign": "node tools/sign.mjs",
    "verify": "node tools/verify.mjs",
    "index": "node tools/build-index.mjs",
    "pack": "node tools/pack-zip.mjs",
    "mod:import": "node tools/import-submission.mjs",
    "should-build": "node tools/should-build.mjs",
    "build:store": "node tools/build-index.mjs && pnpm --filter @daydrift/store build && node tools/sync-dist.mjs",
    "build": "pnpm run build:store",
    "test:signing": "node --test test/signing.test.mjs",
    "test:zip": "node --test test/zip.test.mjs",
    "test": "node --test test/*.test.mjs && node tools/build-index.mjs --strict"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
