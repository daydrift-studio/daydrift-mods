# Ensure consistent line endings across all platforms (Windows, Linux, macOS)
* text=auto eol=lf
*.json text eol=lf
*.gd text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.astro text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.pck binary
*.ddmod binary
*.ico binary
