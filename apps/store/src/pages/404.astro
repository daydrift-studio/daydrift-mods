---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - 页面未找到">
  <div class="container not-found-container">
    <div class="pixel-box">404</div>
    <h1 class="not-found-title">模组或页面不存在</h1>
    <p class="not-found-desc">您访问的模组可能已下架、被维护者撤回，或者链接地址有误。</p>
    <a href="/" class="btn btn-primary">返回商店首页</a>
  </div>
</Layout>

<style>
  .not-found-container {
    text-align: center;
    padding: 6rem 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .pixel-box {
    font-size: 4rem;
    font-weight: 900;
    color: var(--accent-amber);
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
  }

  .not-found-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .not-found-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
</style>
